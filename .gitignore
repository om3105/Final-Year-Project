# Secrets and credentials
.env
.env.*
!.env.example
**/secrets/
**/credentials/
*.pem
*.key
*api_key*
*token.json

# Patient data and model artifacts
data/raw/**
data/processed/**
data/metadata/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep
model/checkpoints/**
