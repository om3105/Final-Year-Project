*.pt
*.pth
*.ckpt
*.safetensors
**/.cache/

# PDFs are kept locally but need license review before redistribution
research/papers/pdf/*.pdf
research/papers/extracted_text/
research/papers/xml/

# Python / Node / editors / temporary
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
node_modules/
.next/
dist/
build/
coverage/
.DS_Store
.idea/
.vscode/
*.tmp
*.log
